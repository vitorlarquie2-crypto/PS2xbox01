<Page x:Class="PS2Xbox.Diagnostics.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#101820">
  <Viewbox Stretch="Uniform">
  <Grid Width="1280" Height="720" Padding="64,40">
    <StackPanel VerticalAlignment="Center" Spacing="12">
      <TextBlock Text="PS2Xbox — teste inicial" FontSize="32" Foreground="White" />
      <TextBlock Text="Diagnóstico de instalação, tela e controle. O jogo ainda não está integrado neste aplicativo." FontSize="24" Foreground="#FFCC66" TextWrapping="Wrap" />
      <TextBlock x:Name="Device" FontSize="22" Foreground="White" TextWrapping="Wrap" />
      <TextBlock x:Name="Status" FontSize="24" Foreground="White" TextWrapping="Wrap" />
      <Border x:Name="Indicator" Height="56" Background="SteelBlue" />
      <TextBlock x:Name="Input" FontSize="22" Foreground="White" TextWrapping="Wrap" />
      <TextBlock Text="A: alternar cor • B: zerar contagem. Teste também os direcionais, analógicos e gatilhos." FontSize="22" Foreground="White" TextWrapping="Wrap" />
      <TextBlock x:Name="Count" FontSize="20" Foreground="White" />
    </StackPanel>
  </Grid>
  </Viewbox>
</Page>
