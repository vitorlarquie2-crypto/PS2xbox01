<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest" IgnorableNamespaces="uap mp">
  <Identity Name="PS2Xbox.Diagnostics" Publisher="CN=PS2XboxDevelopment" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="8385139e-980e-4b39-bad9-94f69a188fc6" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties><DisplayName>PS2Xbox Diagnostics</DisplayName><PublisherDisplayName>PS2Xbox Development</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo></Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" /></Dependencies>
  <Resources><Resource Language="pt-BR" /></Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="PS2Xbox.Diagnostics.App">
      <uap:VisualElements DisplayName="PS2Xbox Diagnostics" Description="Teste de instalação, tela e controle. Sem execução do jogo." BackgroundColor="#101820" Square150x150Logo="Assets\Logo.png" Square44x44Logo="Assets\SmallLogo.png">
        <uap:SplashScreen Image="Assets\Splash.png" BackgroundColor="#101820" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
