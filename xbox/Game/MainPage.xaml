<Page x:Class="PS2Xbox.Game.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Black">
  <Grid>
    <Image x:Name="Screen" Stretch="Uniform" />
    <Border x:Name="Panel" Background="#EE101820" Padding="48" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1100">
      <StackPanel Spacing="16">
        <TextBlock Text="PS2Xbox — jogo recompilado" FontSize="32" Foreground="White" />
        <TextBlock x:Name="Status" Text="Envie Game.zip para LocalState pelo Xbox Device Portal e selecione Importar." FontSize="22" Foreground="White" TextWrapping="Wrap" />
        <Button x:Name="ImportButton" Content="Importar Game.zip" Click="Import_Click" />
        <Button x:Name="StartButton" Content="Iniciar jogo" Click="Start_Click" />
        <TextBlock Text="A: Cross · B: Circle · X: Square · Y: Triangle · Menu: Start · View: Select. Para sair, use o menu do Xbox." FontSize="20" Foreground="LightGray" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
