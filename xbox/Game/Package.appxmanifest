<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest" IgnorableNamespaces="uap mp">
  <Identity Name="PS2Xbox.Game" Publisher="CN=PS2XboxDevelopment" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="cb4c8b85-bb3f-4dbd-b076-72ef69723a10" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties><DisplayName>PS2Xbox Game</DisplayName><PublisherDisplayName>PS2Xbox Development</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo></Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" /></Dependencies>
  <Resources><Resource Language="pt-BR" /></Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="PS2Xbox.Game.App">
      <uap:VisualElements DisplayName="PS2Xbox Game" Description="Runtime PS2 recompilado para Xbox Dev Mode." BackgroundColor="#101820" Square150x150Logo="Assets\Logo.png" Square44x44Logo="Assets\SmallLogo.png">
        <uap:SplashScreen Image="Assets\Splash.png" BackgroundColor="#101820" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
